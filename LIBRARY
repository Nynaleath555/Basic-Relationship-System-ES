  getRelationshipTargets: function (
    scene,
    currentInput,
    npcs
  ) {
    const activeNames =
      Array.isArray(
        scene &&
        scene.activeNames
      )
        ? scene.activeNames
        : [];

    if (
      activeNames.length === 0
    ) {
      return [];
    }

    if (
      scene &&
      scene.explicitTarget
    ) {
      return [
        scene.explicitTarget
      ];
    }

    if (
      activeNames.length === 1
    ) {
      return [
        activeNames[0]
      ];
    }

    return [];
  },

