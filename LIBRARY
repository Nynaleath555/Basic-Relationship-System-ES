/* ============================================================
   BASIC REL v3
   VERSION: 3.0
   ============================================================ */

const REL = {

  VERSION: "3.0",

  genders: {
    man: ["man", "male", "boy"],
    woman: ["woman", "female", "girl"],
    "non-binary": [
      "non-binary",
      "nonbinary",
      "non binary",
      "enby",
      "nb"
    ]
  },

  orientations: [
    "heterosexual",
    "bisexual",
    "pansexual",
    "homosexual",
    "queer"
  ],

  tracker: {
    MAX_HISTORY_ACTIONS: 5,
    ACTIVE_PERSIST_TURNS: 3,
    MIN_NAME_LENGTH: 3
  },

  preferences: {
    LIKE_BONUS: 0.35,
    STRONG_LIKE_BONUS: 0.50,

    DISLIKE_CONFLICT: -0.50,
    DISLIKE_INSISTENCE: -0.75,
    DISLIKE_REPEATED: -1.00
  },

  init: function () {
    if (!state.relationships) {
      state.relationships = {
        playerGender: "unknown",
        characters: {},
        lastInput: "",
        manualEditLastToken: "",
        sceneTracker: {
          activeNames: [],
          lastDetectedNames: [],
          lastTargetName: "",
          turnsSinceDetection: 999
        }
      };
    }

    if (!state.relationships.characters) {
      state.relationships.characters = {};
    }

    if (!state.relationships.playerGender) {
      state.relationships.playerGender = "unknown";
    }

    if (!state.relationships.lastInput) {
      state.relationships.lastInput = "";
    }

    if (
      typeof state.relationships.manualEditLastToken !==
      "string"
    ) {
      state.relationships.manualEditLastToken = "";
    }

    if (!state.relationships.sceneTracker) {
      state.relationships.sceneTracker = {
        activeNames: [],
        lastDetectedNames: [],
        lastTargetName: "",
        turnsSinceDetection: 999
      };
    }

    if (
      !Array.isArray(
        state.relationships.sceneTracker.activeNames
      )
    ) {
      state.relationships.sceneTracker.activeNames = [];
    }

    if (
      !Array.isArray(
        state.relationships.sceneTracker.lastDetectedNames
      )
    ) {
      state.relationships.sceneTracker.lastDetectedNames = [];
    }

    if (
      !Number.isFinite(
        state.relationships.sceneTracker.turnsSinceDetection
      )
    ) {
      state.relationships.sceneTracker.turnsSinceDetection = 999;
    }

    if (
      typeof state.relationships.sceneTracker.lastTargetName !==
      "string"
    ) {
      state.relationships.sceneTracker.lastTargetName = "";
    }

    return state.relationships;
  },

  normalizeGender: function (value) {
    const v =
      String(value || "")
        .toLowerCase()
        .trim();

    for (const gender in this.genders) {
      if (this.genders[gender].includes(v)) {
        return gender;
      }
    }

    return "unknown";
  },

  normalizeOrientation: function (value) {
    const v =
      String(value || "")
        .toLowerCase()
        .trim();

    if (this.orientations.includes(v)) {
      return v;
    }

    if (
      v === "straight" ||
      v === "hetero"
    ) {
      return "heterosexual";
    }

    if (
      v === "gay" ||
      v === "lesbian"
    ) {
      return "homosexual";
    }

    return "unknown";
  },

  parsePlayerGender: function (contextText) {
    const text =
      String(contextText || "");

    let essentials =
      text;

    const cutPoints = [
      text.search(/World Lore:/i),
      text.search(/Story Summary:/i),
      text.search(/Memories:/i)
    ].filter(
      n => n >= 0
    );

    if (
      cutPoints.length > 0
    ) {
      essentials =
        text.slice(
          0,
          Math.min.apply(
            null,
            cutPoints
          )
        );
    }

    let match =
      essentials.match(
        /\bGender:\s*([^\n\r]+)/i
      );

    if (match) {
      const gender =
        this.normalizeGender(
          match[1]
        );

      if (
        gender !== "unknown"
      ) {
        return gender;
      }
    }

    match =
      essentials.match(
        /\bPronouns:\s*([^\n\r]+)/i
      );

    if (match) {
      const pronouns =
        match[1]
          .toLowerCase();

      if (
        /\bshe\s*\/\s*her\b/.test(
          pronouns
        )
      ) {
        return "woman";
      }

      if (
        /\bhe\s*\/\s*him\b/.test(
          pronouns
        )
      ) {
        return "man";
      }

      if (
        /\bthey\s*\/\s*them\b/.test(
          pronouns
        )
      ) {
        return "non-binary";
      }
    }

    return "unknown";
  },

  parsePreferenceList: function (
    entry,
    label
  ) {
    const source =
      String(entry || "");

    const escapedLabel =
      String(label || "")
        .replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&"
        );

    const match =
      source.match(
        new RegExp(
          "^\\s*" +
          escapedLabel +
          "\\s*:\\s*([^\\n\\r]+)",
          "im"
        )
      );

    if (!match) {
      return [];
    }

    return match[1]
      .split(",")
      .map(
        item =>
          String(item || "")
            .trim()
            .replace(
              /^[-•*]\s*/,
              ""
            )
            .trim()
      )
      .filter(Boolean);
  },

  extractFlexibleField: function (
    text,
    patterns
  ) {
    const source =
      String(text || "");

    for (
      const pattern
      of patterns || []
    ) {
      const match =
        source.match(pattern);

      if (
        match &&
        match[1] &&
        String(match[1]).trim()
      ) {
        return String(
          match[1]
        ).trim();
      }
    }

    return "";
  },

  extractFlexibleList: function (
    text,
    patterns
  ) {
    const value =
      this.extractFlexibleField(
        text,
        patterns
      );

    if (!value) {
      return [];
    }

    return value
      .split(
        /,(?![^(]*\))|\s+\band\b\s+|\s*;\s*/
      )
      .map(
        item =>
          String(item || "")
            .trim()
            .replace(
              /^[-•*]\s*/,
              ""
            )
            .trim()
      )
      .filter(Boolean);
  },

  parseFlexibleName: function (
    entry
  ) {
    const source =
      String(entry || "");

    const value =
      this.extractFlexibleField(
        source,
        [
          /^\s*(?:Complete\s+Name|Full\s+Name|Character\s+Name|NPC\s+Name)\s*:\s*([^\n\r]+)/im,
          /^\s*(?:Complete\s+Name|Full\s+Name|Character\s+Name|NPC\s+Name)\s*=\s*([^\n\r]+)/im,
          /^\s*Name\s*:\s*([^\n\r]+)/im,
          /^\s*Name\s*=\s*([^\n\r]+)/im,
          /\b(?:character_name|character-name|full_name)\s*[:=]\s*["']?([^"'\n\r]+)["']?/i
        ]
      );

    return String(
      value || ""
    )
      .trim()
      .replace(
        /^[-•*]\s*/,
        ""
      )
      .trim();
  },

  parseFlexibleAge: function (
    entry
  ) {
    const source =
      String(entry || "");

    let match =
      source.match(
        /\b(?:Age|Years?\s*Old)\s*:\s*(\d{1,3})\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\baged\s+(\d{1,3})\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s*[- ]year[- ]old\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s+years?\s+old\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s+years?\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    return null;
  },

  parseFlexibleGender: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Gender\s*:\s*([^\n\r]+)/im,
          /^\s*Sex\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const direct =
        this.normalizeGender(
          value
        );

      if (
        direct !== "unknown"
      ) {
        return direct;
      }

      const lowered =
        value.toLowerCase();

      if (
        /\bnon[- ]?binary\b/.test(
          lowered
        ) ||
        /\benby\b/.test(
          lowered
        )
      ) {
        return "non-binary";
      }

      if (
        /\bmale\b|\bman\b|\bboy\b/.test(
          lowered
        )
      ) {
        return "man";
      }

      if (
        /\bfemale\b|\bwoman\b|\bgirl\b/.test(
          lowered
        )
      ) {
        return "woman";
      }
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bshe\s*\/\s*her\b/i
        .test(source)
    ) {
      return "woman";
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bhe\s*\/\s*him\b/i
        .test(source)
    ) {
      return "man";
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bthey\s*\/\s*them\b/i
        .test(source)
    ) {
      return "non-binary";
    }

    if (
      /\b(?:he|him)\s+(?:is|identifies as)\s+(?:a\s+)?(?:man|male|boy)\b/i
        .test(source)
    ) {
      return "man";
    }

    if (
      /\b(?:she|her)\s+(?:is|identifies as)\s+(?:a\s+)?(?:woman|female|girl)\b/i
        .test(source)
    ) {
      return "woman";
    }

    if (
      /\b(?:they|them)\s+(?:are|identify as)\s+(?:a\s+)?(?:non[- ]?binary|enby)\b/i
        .test(source)
    ) {
      return "non-binary";
    }

    if (
      /\bnon[- ]?binary\b/i.test(
        source
      )
    ) {
      return "non-binary";
    }

    if (
      /\bfemale\b/i.test(
        source
      )
    ) {
      return "woman";
    }

    if (
      /\bmale\b/i.test(
        source
      )
    ) {
      return "man";
    }

    return "unknown";
  },

  parseFlexibleOrientation: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Orientation\s*:\s*([^\n\r]+)/im,
          /^\s*Sexual\s+Orientation\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const direct =
        this.normalizeOrientation(
          value
        );

      if (
        direct !== "unknown"
      ) {
        return direct;
      }
    }

    const lowered =
      source.toLowerCase();

    if (
      /\bpansexual\b/.test(
        lowered
      )
    ) {
      return "pansexual";
    }

    if (
      /\bbisexual\b/.test(
        lowered
      )
    ) {
      return "bisexual";
    }

    if (
      /\bheterosexual\b/.test(
        lowered
      ) ||
      /\bstraight\b/.test(
        lowered
      )
    ) {
      return "heterosexual";
    }

    if (
      /\bhomosexual\b/.test(
        lowered
      ) ||
      /\bgay\b/.test(
        lowered
      ) ||
      /\blesbian\b/.test(
        lowered
      )
    ) {
      return "homosexual";
    }

    if (
      /\bqueer\b/.test(
        lowered
      )
    ) {
      return "queer";
    }

    return "unknown";
  },

  parseFlexibleRelationshipStatus: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Relationship\s+Status\s*:\s*([^\n\r]+)/im,
          /^\s*Romantic\s+Status\s*:\s*([^\n\r]+)/im,
          /^\s*Status\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const lowered =
        value.toLowerCase();

      if (
        /\bmarried\b/.test(
          lowered
        )
      ) {
        return {
          status: "married",
          target: ""
        };
      }

      if (
        /\bengaged\b/.test(
          lowered
        )
      ) {
        return {
          status: "relationship",
          target: ""
        };
      }

      if (
        /\bin\s+(?:a\s+)?relationship\b/.test(
          lowered
        ) ||
        /\bdating\b/.test(
          lowered
        )
      ) {
        return {
          status: "relationship",
          target: ""
        };
      }

      if (
        /\bin[- ]love\b/.test(
          lowered
        )
      ) {
        return {
          status: "in-love",
          target: ""
        };
      }

      if (
        /\bcrush\b/.test(
          lowered
        )
      ) {
        return {
          status: "crush",
          target: ""
        };
      }

      if (
        /\bsingle\b/.test(
          lowered
        )
      ) {
        return {
          status: "single",
          target: ""
        };
      }
    }

    let match =
      source.match(
        /has\s+a\s+crush\s+on\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "crush",
        target:
          match[1].trim()
      };
    }

    match =
      source.match(
        /is\s+in\s+love\s+with\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "in-love",
        target:
          match[1].trim()
      };
    }

    match =
      source.match(
        /is\s+in\s+a\s+relationship\s+with\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "relationship",
        target:
          match[1].trim()
      };
    }

    match =
      source.match(
        /married\s+to\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "married",
        target:
          match[1].trim()
      };
    }

    return {
      status: "single",
      target: ""
    };
  },

  parseFlexiblePreferenceProfile: function (
    entry
  ) {
    const source =
      String(entry || "");

    const result = {
      hobbies: [],
      likes: [],
      dislikes: []
    };

    result.hobbies =
      this.extractFlexibleList(
        source,
        [
          /^\s*Hobbies?\s*:\s*([^\n\r]+)/im,
          /^\s*Pastimes?\s*:\s*([^\n\r]+)/im,
          /^\s*Hobbies?\s*=\s*([^\n\r]+)/im,
          /\bhobbies?\s+include\s+([^\n\r.]+)/i
        ]
      );

    result.likes =
      this.extractFlexibleList(
        source,
        [
          /^\s*Likes?\s*:\s*([^\n\r]+)/im,
          /^\s*Favorites?\s*:\s*([^\n\r]+)/im,
          /^\s*Favourites?\s*:\s*([^\n\r]+)/im,
          /^\s*Interests?\s*:\s*([^\n\r]+)/im,
          /^\s*Enjoys?\s*:\s*([^\n\r]+)/im,
          /^\s*Likes?\s*=\s*([^\n\r]+)/im
        ]
      );

    result.dislikes =
      this.extractFlexibleList(
        source,
        [
          /^\s*Dislikes?\s*:\s*([^\n\r]+)/im,
          /^\s*Hates?\s*:\s*([^\n\r]+)/im,
          /^\s*Dislikes?\s*=\s*([^\n\r]+)/im,
          /\b(?:dislikes|hates|cannot stand|can't stand|does not like|doesn't like)\s+([^\n\r.]+)/i
        ]
      );

    if (
      result.hobbies.length === 0
    ) {
      const naturalHobbies =
        source.match(
          /\benhoy?s?\s+(?:spending\s+time\s+)?(?:on|with)?\s*([^.\n]+)/i
        );

      if (
        naturalHobbies
      ) {
        const value =
          naturalHobbies[1]
            .trim();

        if (
          value &&
          !/\b(company|people|friends|family)\b/i.test(
            value
          )
        ) {
          result.hobbies =
            value
              .split(
                /,(?![^(]*\))|\s+\band\b\s+/
              )
              .map(
                item =>
                  item.trim()
              )
              .filter(Boolean);
        }
      }
    }

    if (
      result.likes.length === 0
    ) {
      const naturalLike =
        source.match(
          /\b(?:likes?|loves?|enjoys?)\s+([^.\n]+)/i
        );

      if (
        naturalLike
      ) {
        result.likes =
          naturalLike[1]
            .split(
              /,(?![^(]*\))|\s+\band\b\s+/
            )
            .map(
              item =>
                item.trim()
            )
            .filter(Boolean);
      }
    }

    return result;
  },

  getPreferenceProfile: function (
    entry
  ) {
    return {
      hobbies:
        this.parsePreferenceList(
          entry,
          "Hobbies"
        ),

      likes:
        this.parsePreferenceList(
          entry,
          "Likes"
        ),

      dislikes:
        this.parsePreferenceList(
          entry,
          "Dislikes"
        )
    };
  },

  normalizePreferenceTerm: function (
    term
  ) {
    let value =
      String(term || "")
        .toLowerCase()
        .trim();

    value =
      value.replace(
        /^[\s"'`]+|[\s"'`]+$/g,
        ""
      );

    value =
      value.replace(
        /^(?:to|the|a|an)\s+/i,
        ""
      );

    value =
      value.replace(
        /^playing\s+/i,
        ""
      );

    value =
      value.replace(
        /^spending\s+time\s+(?:on|with)\s+/i,
        ""
      );

    return value.trim();
  },

  getWordForms: function (
    word
  ) {
    const clean =
      String(word || "")
        .toLowerCase()
        .replace(
          /[^a-z0-9'-]/g,
          ""
        )
        .trim();

    if (!clean) {
      return [];
    }

    const forms = [
      clean
    ];

    if (
      clean.endsWith("ing") &&
      clean.length > 5
    ) {
      const baseWithoutIng =
        clean.slice(0, -3);

      forms.push(
        baseWithoutIng
      );

      if (
        baseWithoutIng.length >= 3 &&
        !baseWithoutIng.endsWith("e")
      ) {
        forms.push(
          baseWithoutIng + "e"
        );
      }
    }

    if (
      clean.endsWith("ed") &&
      clean.length > 4
    ) {
      forms.push(
        clean.slice(0, -2)
      );
    }

    if (
      clean.endsWith("s") &&
      clean.length > 3
    ) {
      forms.push(
        clean.slice(0, -1)
      );
    }

    return forms.filter(
      (value, index, array) =>
        array.indexOf(value) ===
        index
    );
  },

  tokenisePreferenceTerm: function (
    term
  ) {
    const normalized =
      this.normalizePreferenceTerm(
        term
      );

    if (!normalized) {
      return [];
    }

    const ignored = [
      "the",
      "a",
      "an",
      "to",
      "of",
      "for",
      "with",
      "and",
      "or",
      "on",
      "in",
      "at",
      "about",
      "playing",
      "play",
      "plays",
      "doing",
      "do",
      "does"
    ];

    return normalized
      .split(/\s+/)
      .map(
        token =>
          token
            .replace(
              /^[^a-z0-9]+|[^a-z0-9]+$/gi,
              ""
            )
            .toLowerCase()
      )
      .filter(
        token =>
          token &&
          !ignored.includes(
            token
          )
      );
  },

  wordLike: function (
    a,
    b
  ) {
    const formsA =
      this.getWordForms(a);

    const formsB =
      this.getWordForms(b);

    for (
      const formA
      of formsA
    ) {
      for (
        const formB
        of formsB
      ) {
        if (
          formA === formB
        ) {
          return true;
        }
      }
    }

    return false;
  },

  preferenceMatchesInput: function (
    preference,
    input
  ) {
    const source =
      String(input || "")
        .toLowerCase();

    const normalized =
      this.normalizePreferenceTerm(
        preference
      );

    if (
      !normalized ||
      !source
    ) {
      return false;
    }

    const escaped =
      normalized.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );

    try {
      if (
        new RegExp(
          "\\b" +
          escaped +
          "\\b",
          "i"
        ).test(source)
      ) {
        return true;
      }
    } catch (error) {
      // Continue with token matching.
    }

    const tokens =
      this.tokenisePreferenceTerm(
        preference
      );

    if (
      tokens.length === 0
    ) {
      return false;
    }

    const inputTokens =
      source
        .split(/\s+/)
        .map(
          token =>
            token.replace(
              /^[^a-z0-9]+|[^a-z0-9]+$/gi,
              ""
            )
        )
        .filter(Boolean);

    if (
      tokens.length === 1
    ) {
      return inputTokens.some(
        inputToken =>
          this.wordLike(
            tokens[0],
            inputToken
          )
      );
    }

    for (
      const token
      of tokens
    ) {
      const found =
        inputTokens.some(
          inputToken =>
            this.wordLike(
              token,
              inputToken
            )
        );

      if (!found) {
        return false;
      }
    }

    return true;
  },

  findPreferenceMatches: function (
    preferences,
    input
  ) {
    const found = [];

    for (
      const preference
      of preferences || []
    ) {
      if (
        this.preferenceMatchesInput(
          preference,
          input
        )
      ) {
        found.push(
          preference
        );
      }
    }

    return found;
  },

  hasAny: function (
    text,
    patterns
  ) {
    const t =
      String(text || "")
        .toLowerCase();

    for (
      const pattern
      of patterns
    ) {
      if (
        pattern.test(t)
      ) {
        return true;
      }
    }

    return false;
  },

  getPlayerPreferenceAttitude: function (
    input
  ) {
    const text =
      String(input || "")
        .toLowerCase();

    const stronglyNegative =
      this.hasAny(
        text,
        [
          /\bi hate\b/,
          /\bi really hate\b/,
          /\bi can't stand\b/,
          /\bi cannot stand\b/,
          /\bi despise\b/,
          /\bawful\b/,
          /\bterrible\b/,
          /\bhorrible\b/,
          /\bdisgusting\b/,
          /\bpathetic\b/,
          /\bworst\b/,
          /\bannoying\b/,
          /\bgarbage\b/,
          /\btrash\b/
        ]
      );

    const negative =
      this.hasAny(
        text,
        [
          /\bi don't like\b/,
          /\bi do not like\b/,
          /\bi dislike\b/,
          /\bi'm not a fan\b/,
          /\bi am not a fan\b/,
          /\bnot very good\b/,
          /\bnot that good\b/,
          /\bnot impressive\b/,
          /\bnot amazing\b/,
          /\bnot great\b/,
          /\bbad\b/
        ]
      );

    const strongPositive =
      this.hasAny(
        text,
        [
          /\bis absolutely amazing\b/,
          /\bis incredible\b/,
          /\bis fantastic\b/,
          /\bis wonderful\b/,
          /\bis awesome\b/,
          /\bis excellent\b/,
          /\bis brilliant\b/,
          /\bis the best\b/,
          /\bis perfect\b/,
          /\bi absolutely love\b/,
          /\bi really love\b/,
          /\bi love\b/
        ]
      );

    const positive =
      this.hasAny(
        text,
        [
          /\bis great\b/,
          /\bis amazing\b/,
          /\bis good\b/,
          /\bis cool\b/,
          /\bis awesome\b/,
          /\bis nice\b/,
          /\bis wonderful\b/,
          /\bis impressive\b/,
          /\bis talented\b/,
          /\bis beautiful\b/,
          /\bis interesting\b/,
          /\bi like\b/,
          /\bi love\b/,
          /\bi enjoy\b/,
          /\bi'm a fan\b/,
          /\bi am a fan\b/
        ]
      );

    const defense =
      this.hasAny(
        text,
        [
          /\byou're wrong\b/,
          /\byou are wrong\b/,
          /\byou only say that\b/,
          /\byou just say that\b/,
          /\bthat's only because\b/,
          /\bthat is only because\b/,
          /\bdon't judge\b/,
          /\bdo not judge\b/,
          /\bgive .* a chance\b/,
          /\bbut .* is great\b/,
          /\bbut .* is amazing\b/,
          /\bbut .* is incredible\b/,
          /\bbut .* is wonderful\b/,
          /\bbut .* is awesome\b/,
          /\bbut .* is talented\b/,
          /\bbut .* is good\b/
        ]
      );

    const attitude =
      stronglyNegative ||
      negative
        ? "negative"
        : defense ||
          strongPositive ||
          positive
        ? "positive"
        : "neutral";

    return {
      attitude,
      strongPositive:
        strongPositive,
      defense:
        defense,
      negative:
        stronglyNegative ||
        negative
    };
  },

  applyManualEdit: function () {
    const relationships =
      this.init();

    const result = {
      applied: false,
      name: "",
      reason: ""
    };

    if (
      typeof RELStatus === "undefined" ||
      !Array.isArray(storyCards)
    ) {
      return result;
    }

    const config =
      RELStatus.getConfigCard(
        storyCards
      );

    if (!config) {
      return result;
    }

    const entry =
      String(
        config.entry || ""
      );

    const manualMatch =
      entry.match(
        /^\s*Manual\s+Stat\s+Edit\s*:\s*([\s\S]*)$/im
      );

    if (!manualMatch) {
      return result;
    }

    const section =
      String(
        manualMatch[1] || ""
      );

    const applyMatch =
      section.match(
        /\bApply\s*(?:\:|=)?\s*([^\n\r]+)/i
      );

    const applyValue =
      applyMatch
        ? applyMatch[1]
            .trim()
            .toLowerCase()
        : "";

    if (
      applyValue !== "yes" &&
      applyValue !== "true" &&
      applyValue !== "1"
    ) {
      relationships.manualEditLastToken =
        "";

      return result;
    }

    const parseValue = (
      rawValue,
      min,
      max
    ) => {

      const value =
        String(
          rawValue || ""
        )
          .trim()
          .toLowerCase();

      if (
        !value ||
        value === "unchanged"
      ) {
        return {
          valid: true,
          changed: false,
          value: null
        };
      }

      const normalized =
        value.replace(
          ",",
          "."
        );

      if (
        !/^[+-]?(?:\d+(?:\.\d+)?|\.\d+)$/
          .test(normalized)
      ) {
        return {
          valid: false,
          changed: false,
          value: null
        };
      }

      const number =
        Number(
          normalized
        );

      if (
        !Number.isFinite(
          number
        )
      ) {
        return {
          valid: false,
          changed: false,
          value: null
        };
      }

      const clamped =
        Math.max(
          min,
          Math.min(
            max,
            number
          )
        );

      return {
        valid: true,
        changed: true,
        value: clamped
      };
    };

    const numberPattern =
      "[+-]?(?:\\d+(?:[\\.,]\\d+)?|\\.\\d+)";

    let characterTarget =
      "";

    const characterFieldMatch =
      section.match(
        /\b(?:Character|Target|NPC|Name)\s*(?:\:|=)\s*([^\n\r]+)/i
      );

    if (
      characterFieldMatch
    ) {
      characterTarget =
        String(
          characterFieldMatch[1] || ""
        )
          .trim()
          .replace(
            /\s+/g,
            " "
          );
    }

    let friendshipRaw =
      null;

    let romanceRaw =
      null;

    const friendshipLabel =
      section.match(
        new RegExp(
          "\\bFriendship\\s*(?::|=|is|to)?\\s*(" +
          numberPattern +
          "|unchanged)\\b",
          "i"
        )
      );

    if (
      friendshipLabel
    ) {
      friendshipRaw =
        friendshipLabel[1];
    }

    const romanceLabel =
      section.match(
        new RegExp(
          "\\bRomance\\s*(?::|=|is|to)?\\s*(" +
          numberPattern +
          "|unchanged)\\b",
          "i"
        )
      );

    if (
      romanceLabel
    ) {
      romanceRaw =
        romanceLabel[1];
    }

    if (
      !friendshipRaw
    ) {
      const naturalFriendship =
        section.match(
          new RegExp(
            "\\bfriendship\\s+(?:to\\s+)?(" +
            numberPattern +
            ")\\b",
            "i"
          )
        );

      if (
        naturalFriendship
      ) {
        friendshipRaw =
          naturalFriendship[1];
      }
    }

    if (
      !romanceRaw
    ) {
      const naturalRomance =
        section.match(
          new RegExp(
            "\\bromance\\s+(?:to\\s+)?(" +
            numberPattern +
            ")\\b",
            "i"
          )
        );

      if (
        naturalRomance
      ) {
        romanceRaw =
          naturalRomance[1];
      }
    }

    if (
      !characterTarget
    ) {
      const withTarget =
        section.match(
          new RegExp(
            "\\b(?:friendship|romance)\\s+(?:to\\s+)?" +
            numberPattern +
            "\\s+(?:with|for)\\s+([^\\n\\r]+)",
            "i"
          )
        );

      if (
        withTarget
      ) {
        characterTarget =
          withTarget[1]
            .trim()
            .replace(
              /\s+/g,
              " "
            );
      }
    }

    if (
      !characterTarget
    ) {
      const namedStatEdit =
        section.match(
          new RegExp(
            "\\b(?:set|change|edit|update)?\\s*([^\\n\\r,;:]+?)\\s+(friendship|romance)\\s*(?:to|=|:)?\\s*" +
            numberPattern,
            "i"
          )
        );

      if (
        namedStatEdit
      ) {
        characterTarget =
          namedStatEdit[1]
            .trim()
            .replace(
              /^(?:set|change|edit|update)\\s+/i,
              ""
            )
            .replace(
              /\s+/g,
              " "
            );
      }
    }

    if (
      !characterTarget
    ) {
      return result;
    }

    const friendship =
      parseValue(
        friendshipRaw || "unchanged",
        -100,
        100
      );

    const romance =
      parseValue(
        romanceRaw || "unchanged",
        0,
        100
      );

    if (
      !friendship.valid ||
      !romance.valid
    ) {
      return result;
    }

    if (
      !friendship.changed &&
      !romance.changed
    ) {
      return result;
    }

    const targetName =
      characterTarget;

    const token =
      targetName.toLowerCase() +
      "|" +
      String(
        friendshipRaw || "unchanged"
      )
        .trim()
        .toLowerCase() +
      "|" +
      String(
        romanceRaw || "unchanged"
      )
        .trim()
        .toLowerCase();

    if (
      relationships.manualEditLastToken ===
      token
    ) {
      return result;
    }

    let targetKey =
      Object.keys(
        relationships.characters
      ).find(
        key =>
          key
            .trim()
            .toLowerCase() ===
          targetName.toLowerCase()
      );

    if (!targetKey) {
      const firstMatches =
        Object.keys(
          relationships.characters
        ).filter(
          key =>
            key
              .split(/\s+/)[0]
              .trim()
              .toLowerCase() ===
            targetName.toLowerCase()
        );

      if (
        firstMatches.length ===
        1
      ) {
        targetKey =
          firstMatches[0];
      }
    }

    if (!targetKey) {
      return result;
    }

    const character =
      relationships.characters[
        targetKey
      ];

    if (
      friendship.changed
    ) {
      character.friendship =
        friendship.value;
    }

    if (
      romance.changed
    ) {
      character.romance =
        romance.value;
    }

    relationships.manualEditLastToken =
      token;

    let updatedEntry =
      entry;

    updatedEntry =
      updatedEntry.replace(
        /^(\s*Apply\s*(?:\:|=)?\s*)[^\r\n]*/im,
        "$1no"
      );

    updatedEntry =
      updatedEntry.replace(
        /^(\s*(?:Character|Target)\s*(?:\:|=)\s*)[^\r\n]*/im,
        "$1"
      );

    updatedEntry =
      updatedEntry.replace(
        /^(\s*Friendship\s*(?:\:|=)\s*)[^\r\n]*/im,
        "$1unchanged"
      );

    updatedEntry =
      updatedEntry.replace(
        /^(\s*Romance\s*(?:\:|=)\s*)[^\r\n]*/im,
        "$1unchanged"
      );

    const configIndex =
      storyCards.indexOf(
        config
      );

    if (
      configIndex >= 0
    ) {
      const keys =
        String(
          config.keys ||
          RELStatus.CONFIG_KEY
        );

      const type =
        String(
          config.type ||
          RELStatus.CONFIG_TYPE
        );

      updateStoryCard(
        configIndex,
        keys,
        updatedEntry,
        type
      );

      config.entry =
        updatedEntry;
    }

    return {
      applied: true,
      name: targetKey,
      reason: "manual-edit"
    };
  },

  parseCards: function (
    cards
  ) {
    const result = [];

    for (
      const card
      of cards || []
    ) {

      const cardType =
        String(
          card.type || ""
        )
          .trim()
          .toLowerCase();

      if (
        cardType !==
        "character"
      ) {
        continue;
      }

      const entry =
        String(
          card.entry || ""
        );

      if (
        !entry.trim()
      ) {
        continue;
      }

      const nameMatch =
        entry.match(
          /Complete name:\s*([^\n\r]+)/i
        );

      let name =
        nameMatch
          ? nameMatch[1].trim()
          : "";

      if (!name) {
        name =
          this.parseFlexibleName(
            entry
          );
      }

      if (!name) {
        continue;
      }

      const demoMatch =
        entry.match(
          /^\s*(\d+)\s+years?,\s*([^,\n]+),\s*([^,\n]+),\s*([^\n\r]+)$/im
        );

      let age =
        demoMatch
          ? Number(
              demoMatch[1]
            )
          : null;

      let gender =
        demoMatch
          ? this.normalizeGender(
              demoMatch[2]
            )
          : "unknown";

      let orientation =
        demoMatch
          ? this.normalizeOrientation(
              demoMatch[3]
            )
          : "unknown";

      if (
        age === null ||
        !Number.isFinite(age)
      ) {
        age =
          this.parseFlexibleAge(
            entry
          );
      }

      if (
        gender === "unknown"
      ) {
        gender =
          this.parseFlexibleGender(
            entry
          );
      }

      if (
        orientation === "unknown"
      ) {
        orientation =
          this.parseFlexibleOrientation(
            entry
          );
      }

      let romanticStatus =
        "single";

      let romanticTarget =
        "";

      let statusFound =
        false;

      let match =
        entry.match(
          /has a crush on\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "crush";

        romanticTarget =
          match[1].trim();

        statusFound =
          true;
      }

      match =
        entry.match(
          /is in love with\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "in-love";

        romanticTarget =
          match[1].trim();

        statusFound =
          true;
      }

      match =
        entry.match(
          /is in a relationship with\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "relationship";

        romanticTarget =
          match[1].trim();

        statusFound =
          true;
      }

      match =
        entry.match(
          /married to\s+([^.\n]+)/i
        );

      if (match) {
        romanticStatus =
          "married";

        romanticTarget =
          match[1].trim();

        statusFound =
          true;
      }

      if (
        demoMatch
      ) {
        const statusText =
          demoMatch[4]
            .trim()
            .toLowerCase();

        if (
          !statusFound
        ) {
          if (
            /\bmarried\b/.test(
              statusText
            )
          ) {
            romanticStatus =
              "married";

            statusFound =
              true;
          } else if (
            /\bcrush\b/.test(
              statusText
            )
          ) {
            romanticStatus =
              "crush";

            statusFound =
              true;
          } else if (
            /\bin[- ]love\b/.test(
              statusText
            )
          ) {
            romanticStatus =
              "in-love";

            statusFound =
              true;
          } else if (
            /\b(?:relationship|dating|engaged)\b/.test(
              statusText
            )
          ) {
            romanticStatus =
              "relationship";

            statusFound =
              true;
          } else if (
            /\bsingle\b/.test(
              statusText
            )
          ) {
            romanticStatus =
              "single";

            statusFound =
              true;
          }
        }
      }

      if (
        !statusFound
      ) {
        const flexibleStatus =
          this.parseFlexibleRelationshipStatus(
            entry
          );

        romanticStatus =
          flexibleStatus.status;

        romanticTarget =
          flexibleStatus.target;
      }

      const strictPreferences =
        this.getPreferenceProfile(
          entry
        );

      const flexiblePreferences =
        this.parseFlexiblePreferenceProfile(
          entry
        );

      const hobbies =
        strictPreferences.hobbies.length >
        0
          ? strictPreferences.hobbies
          : flexiblePreferences.hobbies;

      const likes =
        strictPreferences.likes.length >
        0
          ? strictPreferences.likes
          : flexiblePreferences.likes;

      const dislikes =
        strictPreferences.dislikes.length >
        0
          ? strictPreferences.dislikes
          : flexiblePreferences.dislikes;

      result.push({
        id:
          card.id,

        name:
          name,

        lowerName:
          name.toLowerCase(),

        age:
          age,

        gender:
          gender,

        orientation:
          orientation,

        romanticStatus:
          romanticStatus,

        romanticTarget:
          romanticTarget,

        cardEntry:
          entry,

        hobbies:
          hobbies,

        likes:
          likes,

        dislikes:
          dislikes
      });
    }

    return result;
  },

  syncCharacters: function (
    cards
  ) {
    const relationships =
      this.init();

    const npcs =
      this.parseCards(
        cards
      );

    for (
      const npc
      of npcs
    ) {

      if (
        !relationships.characters[
          npc.name
        ]
      ) {
        relationships.characters[
          npc.name
        ] = {
          friendship: 0,
          romance: 0
        };
      }

      relationships.characters[
        npc.name
      ].age =
        npc.age;

      relationships.characters[
        npc.name
      ].gender =
        npc.gender;

      relationships.characters[
        npc.name
      ].orientation =
        npc.orientation;

      relationships.characters[
        npc.name
      ].romanticStatus =
        npc.romanticStatus;

      relationships.characters[
        npc.name
      ].romanticTarget =
        npc.romanticTarget;

      relationships.characters[
        npc.name
      ].hobbies =
        npc.hobbies;

      relationships.characters[
        npc.name
      ].likes =
        npc.likes;

      relationships.characters[
        npc.name
      ].dislikes =
        npc.dislikes;
    }

    return npcs;
  },

  compatible: function (
    playerGender,
    npcGender,
    orientation
  ) {
    if (
      playerGender ===
        "unknown" ||
      npcGender ===
        "unknown" ||
      orientation ===
        "unknown"
    ) {
      return false;
    }

    if (
      orientation ===
        "bisexual" ||
      orientation ===
        "pansexual" ||
      orientation ===
        "queer"
    ) {
      return true;
    }

    if (
      orientation ===
        "heterosexual"
    ) {
      return (
        (
          npcGender ===
            "man" &&
          playerGender ===
            "woman"
        ) ||
        (
          npcGender ===
            "woman" &&
          playerGender ===
            "man"
        )
      );
    }

    if (
      orientation ===
        "homosexual"
    ) {
      return (
        npcGender ===
        playerGender
      );
    }

    return false;
  },

  romanceMultiplier: function (
    status
  ) {
    if (
      status ===
        "single"
    ) {
      return 1.00;
    }

    if (
      status ===
        "crush"
    ) {
      return 0.45;
    }

    if (
      status ===
        "in-love"
    ) {
      return 0.25;
    }

    if (
      status ===
        "relationship"
    ) {
      return 0.15;
    }

    if (
      status ===
        "married"
    ) {
      return 0.08;
    }

    return 1.00;
  },

  friendshipReceptivity: function (
    friendship
  ) {
    const value =
      Number(
        friendship || 0
      );

    if (
      value <= 0
    ) {
      return 0.85;
    }

    if (
      value <= 20
    ) {
      return 0.95;
    }

    if (
      value <= 40
    ) {
      return 1.05;
    }

    if (
      value <= 60
    ) {
      return 1.15;
    }

    if (
      value <= 80
    ) {
      return 1.30;
    }

    return 1.45;
  },

