      );

      lines.push(
        "Romantic receptivity from friendship: " +
        this.getRomanticReceptivity(
          data.friendship
        ) +
        "."
      );

      lines.push(
        "Romantic compatibility: " +
        (
          compatible
            ? "POSSIBLE"
            : "IMPOSSIBLE"
        ) +
        "."
      );

      lines.push(
        "Interaction target: " +
        (
          isTarget
            ? "YES"
            : "NO"
        ) +
        "."
      );

      if (
        !isTarget &&
        activeNames.length > 1
      ) {
        lines.push(
          "Do not assume the player's ambiguous action is directed at this NPC."
        );
      }

      if (
        !compatible
      ) {
        lines.push(
          "ROMANCE LOCK: This NPC cannot develop romantic or sexual attraction toward the player. Do not portray flirting, affection, intimacy, or closeness as reciprocal romantic attraction."
        );
      }

      if (
        npc.romanticStatus ===
        "crush"
      ) {
        lines.push(
          "Existing crush on " +
          npc.romanticTarget +
          ". Romance with the player is slower and more complicated."
        );
      }

      if (
        npc.romanticStatus ===
        "in-love"
      ) {
        lines.push(
          "Already in love with " +
          npc.romanticTarget +
          ". Romance with the player is very difficult."
        );
      }

      if (
        npc.romanticStatus ===
        "relationship"
      ) {
        lines.push(
          "Already in a relationship with " +
          npc.romanticTarget +
          ". Any attraction to the player is conflicted and difficult."
        );
      }

      if (
        npc.romanticStatus ===
        "married"
      ) {
        lines.push(
          "Married to " +
          npc.romanticTarget +
          ". Any attraction to the player is highly difficult and consequential."
        );
      }

      lines.push(
        "Friendship and romance are independent."
      );

      lines.push(
        "Romance describes this NPC's feelings toward the player, not the player's feelings."
      );
    }

    lines.push("");

    lines.push(
      "[END RELATIONSHIP CONTEXT]"
    );

    return lines.join(
      "\n"
    );
  }
};


const RELStatus = {

  CONFIG_KEY:
    "__BASIC_REL_CONFIG__",

  CONFIG_TYPE:
    "BASIC_REL_CONFIG",

  STATUS_TYPE:
    "BASIC_REL_STATUS",

  WATERMARK:
    "Basic REL v3 • @Nynaleath",

  round: function (
    value
  ) {
    return Math.round(
      Number(
        value || 0
      ) *
      10
    ) / 10;
  },

  normalizeName: function (
    value
  ) {
    return String(
      value || ""
    )
      .trim()
      .replace(
        /\s+/g,
        " "
      );
  },

  cleanCharacterName: function (
    value
  ) {
    let name =
      this.normalizeName(
        value
      );

    name =
      name
        .replace(
          /^[-•*]\s*/,
          ""
        )
        .trim();

    return name;
  },

  getConfigCard: function (
    cards
  ) {
    for (
      const card
      of cards || []
    ) {

      const keys =
        String(
          card.keys || ""
        );

      const keyList =
        keys
          .split(",")
          .map(
            x =>
              x.trim()
          );

      const singularKey =
        String(
          card.key || ""
        ).trim();

      if (
        keyList.includes(
          this.CONFIG_KEY
        ) ||
        singularKey ===
          this.CONFIG_KEY ||
        String(
          card.type || ""
        ) ===
          this.CONFIG_TYPE
      ) {
        return card;
      }
    }

    return null;
  },

  ensureManualEditSection: function (
    config
  ) {
    if (!config) {
      return null;
    }

    let entry =
      String(
        config.entry || ""
      );

    if (
      !entry.trim()
    ) {
      return config;
    }

    entry =
      entry.replace(
        /BASIC REL v2/g,
        "BASIC REL v3"
      );

    entry =
      entry.replace(
        /Basic REL v2\s+•\s+@Nynaleath/g,
        this.WATERMARK
      );

    if (
      /^\s*Manual\s+Stat\s+Edit\s*:/im.test(
        entry
      )
    ) {
      if (
        config.entry !==
        entry
      ) {
        const index =
          storyCards.indexOf(
            config
          );

        if (
          index >= 0
        ) {
          updateStoryCard(
            index,
            String(
              config.keys ||
              this.CONFIG_KEY
            ),
            entry,
            String(
              config.type ||
              this.CONFIG_TYPE
            )
          );

          config.entry =
            entry;
        }
      }

      return config;
    }

    const manualSection =
      "\n\n" +
      "Manual Stat Edit:\n" +
      "Character:\n" +
      "Apply: no\n" +
      "Friendship: unchanged\n" +
      "Romance: unchanged\n";

    const watermarkPattern =
      /(?:Basic REL v\d+\s+•\s+@Nynaleath)/i;

    if (
      watermarkPattern.test(
        entry
      )
    ) {
      entry =
        entry.replace(
          watermarkPattern,
          manualSection +
          "\n" +
          this.WATERMARK
        );
    } else {
      entry +=
        manualSection +
        "\n" +
        this.WATERMARK;
    }

    const index =
      storyCards.indexOf(
        config
      );

    if (
      index >= 0
    ) {
      updateStoryCard(
        index,
        String(
          config.keys ||
          this.CONFIG_KEY
        ),
        entry,
        String(
          config.type ||
          this.CONFIG_TYPE
        )
      );

      config.entry =
        entry;
    }

    return config;
  },

  ensureConfigCard: function () {
    const existing =
      this.getConfigCard(
        storyCards
      );

    if (existing) {
      return this.ensureManualEditSection(
        existing
      );
    }

    const entry =
      "BASIC REL v3 — Relationship Status Configuration\n\n" +

      "Tracked Characters:\n\n" +

      "INSTRUCTIONS:\n" +
      "Enter the exact names of the NPCs you want to track.\n" +
      "Separate multiple names with commas.\n\n" +

      "Example:\n" +
      "Character A, Character B, Character C\n\n" +

      "Only characters listed in Tracked Characters will receive a visible Relationship Status card.\n\n" +

      "You can edit this card at any time during the adventure.\n" +
      "For best compatibility, place the names in the Story Card Notes field.\n" +
      "If Notes are unavailable to the script, use the Tracked Characters section in this Entry instead.\n\n" +

      "The Basic REL system continues tracking relationship data internally even when a character is not displayed.\n\n" +

      "Manual Stat Edit:\n" +
      "Character:\n" +
      "Apply: no\n" +
      "Friendship: unchanged\n" +
      "Romance: unchanged\n\n" +

      this.WATERMARK;

    addStoryCard(
      this.CONFIG_KEY,
      entry,
      this.CONFIG_TYPE
    );

    return this.getConfigCard(
      storyCards
    );
  },

  extractNamesFromText: function (
    text
  ) {
    const source =
      String(
        text || ""
      );

    if (
      !source.trim()
    ) {
      return [];
    }

    const names =
      [];

    const fragments =
      source.split(
        /[,;\n]+/
      );

    for (
      const fragment
      of fragments
    ) {
      const name =
        this.cleanCharacterName(
          fragment
        );

      if (!name) {
        continue;
      }

      if (
        !names.some(
          existing =>
            existing
              .toLowerCase() ===
            name.toLowerCase()
        )
      ) {
        names.push(
          name
        );
      }
    }

    return names;
  },

  getTrackedCharacters: function () {
    const config =
      this.ensureConfigCard();

    if (!config) {
      return [];
    }

    const notes =
      String(
        config.notes || ""
      ).trim();

    if (notes) {
      const noteNames =
        this.extractNamesFromText(
          notes
        );

      if (
        noteNames.length > 0
      ) {
        return noteNames;
      }
    }

    const entry =
      String(
        config.entry || ""
      );

    const trackedMatch =
      entry.match(
        /Tracked Characters\s*:\s*([\s\S]*?)(?=\n\s*(?:INSTRUCTIONS|Manual Stat Edit)\s*:)/i
      );

    if (
      trackedMatch &&
      trackedMatch[1]
    ) {
      return this.extractNamesFromText(
        trackedMatch[1]
      );
    }

    const lines =
      entry.split(
        /\r?\n/
      );

    let collecting =
      false;

    const collected =
      [];

    for (
      const line
      of lines
    ) {
      if (
        /^\s*Tracked Characters\s*:\s*$/i
          .test(line)
      ) {
        collecting =
          true;

        continue;
      }

      if (
        collecting &&
        (
          /^\s*INSTRUCTIONS\s*:\s*$/i
            .test(line) ||
          /^\s*Manual Stat Edit\s*:\s*$/i
            .test(line)
        )
      ) {
        break;
      }

      if (
        collecting &&
        line.trim()
      ) {
        collected.push(
          line.trim()
        );
      }
    }

    return this.extractNamesFromText(
      collected.join(
        "\n"
      )
    );
  },

  findTrackedNPC: function (
    trackedName,
    npcs
  ) {
    const target =
      this.normalizeName(
        trackedName
      ).toLowerCase();

    for (
      const npc
      of npcs || []
    ) {
      if (
        npc.name
          .toLowerCase() ===
        target
      ) {
        return npc;
      }
    }

    const firstMatches =
      (npcs || []).filter(
        npc =>
          npc.name
            .split(/\s+/)[0]
            .toLowerCase() ===
          target
      );

    if (
      firstMatches.length ===
      1
    ) {
      return firstMatches[0];
    }

    const partMatches =
      (npcs || []).filter(
        npc =>
          npc.name
            .split(/\s+/)
            .some(
              part =>
                part.toLowerCase() ===
                target
            )
      );

    if (
      partMatches.length ===
      1
    ) {
      return partMatches[0];
    }

    return null;
  },

  getStatusKey: function (
    characterName
  ) {
    const clean =
      this.normalizeName(
        characterName
      )
        .toUpperCase()
        .replace(
          /[^A-Z0-9]+/g,
          "_"
        )
        .replace(
          /^_+|_+$/g,
          ""
        );

    return (
      "__BASIC_REL_STATUS_" +
      clean +
      "__"
    );
  },

  getStatusCard: function (
    characterName
  ) {
    const key =
      this.getStatusKey(
        characterName
      );

    for (
      let index = 0;
      index < storyCards.length;
      index++
    ) {
      const card =
        storyCards[index];

      const keys =
        String(
          card.keys || ""
        );

      const keyList =
        keys
          .split(",")
          .map(
            x =>
              x.trim()
          );

      if (
        keyList.includes(
          key
        )
      ) {
        return {
          card:
            card,
          index:
            index
        };
      }

      if (
        String(
          card.type || ""
        ) ===
          this.STATUS_TYPE &&
        String(
          card.entry || ""
        ).startsWith(
          characterName +
          " — Relationship"
        )
      ) {
        return {
          card:
            card,
          index:
            index
        };
      }
    }

    return null;
  },

  buildEntry: function (
    characterName,
    character,
    npc
  ) {
    const friendship =
      this.round(
        character.friendship
      );

    const romance =
      this.round(
        character.romance
      );

    const activeNames =
      typeof REL !==
        "undefined" &&
      typeof REL.getActiveScene ===
        "function"
        ? REL.getActiveScene()
        : [];

    const isActive =
      activeNames.includes(
        characterName
      );

    const activeMarker =
      isActive
        ? "👥💕 ACTIVE\n\n"
        : "";

    return (
      characterName +
      " — Relationship\n\n" +

      activeMarker +

      "Friendship: " +
      friendship +
      " — " +
      REL.getFriendshipLevel(
        friendship
      ) +
      "\n" +

      "Romance: " +
      romance +
      " — " +
      REL.getRomanceLevel(
        romance
      ) +
      "\n\n" +

      "This Relationship Status card is automatically generated by Basic REL v3.\n" +
      "Friendship and romance are tracked independently.\n" +
      "Romance represents " +
      characterName +
      "'s feelings toward the player.\n\n" +

      "Tracked through the Basic REL v3 configuration card.\n\n" +

      this.WATERMARK
    );
  },

  update: function (
    characterName,
    npc
  ) {
    const relationships =
      REL.init();

    const character =
      relationships.characters[
        characterName
      ];

    if (!character) {
      return;
    }

    const key =
      this.getStatusKey(
        characterName
      );

    const entry =
      this.buildEntry(
        characterName,
        character,
        npc
      );

    const existing =
      this.getStatusCard(
        characterName
      );

    if (existing) {

      updateStoryCard(
        existing.index,
        key,
        entry,
        this.STATUS_TYPE
      );

    } else {

      addStoryCard(
        key,
        entry,
        this.STATUS_TYPE
      );
    }
  },

  updateTrackedStatuses: function (
    npcs
  ) {
    const trackedNames =
      this.getTrackedCharacters();

    if (
      trackedNames.length === 0
    ) {
      return;
    }

    for (
      const trackedName
      of trackedNames
    ) {
      const npc =
        this.findTrackedNPC(
          trackedName,
          npcs
        );

      if (!npc) {
        continue;
      }

      this.update(
        npc.name,
        npc
      );
    }
  }
};
