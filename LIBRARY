  getFriendshipDelta: function (
    signals
  ) {
    let delta =
      0;

    if (
      signals.friendshipStrongPositive
    ) {
      delta += 1.5;

    } else if (
      signals.friendshipMeaningful
    ) {
      delta += 0.8;

    } else if (
      signals.friendshipSocial
    ) {
      delta += 0.5;

    } else if (
      signals.friendshipSharedInterest ||
      signals.friendshipInterest
    ) {
      delta += 0.35;

    } else if (
      signals.friendshipGeneralPositive
    ) {
      delta += 0.25;
    }

    if (
      signals.friendshipStrongNegative
    ) {
      delta -= 2.0;

    } else if (
      signals.friendshipNegative ||
      signals.friendshipDistance
    ) {
      delta -= 0.9;
    }

    return delta;
  },

  countPreviousPreferenceConflicts: function (
    preference,
    npc,
    currentInput
  ) {
    const historyActions =
      this.getHistoryActions();

    if (
      historyActions.length === 0
    ) {
      return 0;
    }

    let count =
      0;

    const currentNormalized =
      String(
        currentInput || ""
      )
        .toLowerCase();

    for (
      const action
      of historyActions
    ) {
      const historyText =
        String(
          action || ""
        )
          .toLowerCase();

      if (!historyText) {
        continue;
      }

      if (
        !this.preferenceMatchesInput(
          preference,
          historyText
        )
      ) {
        continue;
      }

      const attitude =
        this.getPlayerPreferenceAttitude(
          historyText
        );

      if (
        attitude.attitude ===
        "positive"
      ) {
        count++;
      }
    }

    return count;
  },

  getPreferenceEffect: function (
    npc,
    input
  ) {
    const source =
      String(
        input || ""
      );

    const profile = {
      hobbies:
        Array.isArray(
          npc.hobbies
        )
          ? npc.hobbies
          : [],

      likes:
        Array.isArray(
          npc.likes
        )
          ? npc.likes
          : [],

      dislikes:
        Array.isArray(
          npc.dislikes
        )
          ? npc.dislikes
          : []
    };

    const attitude =
      this.getPlayerPreferenceAttitude(
        source
      );

    const positivePreferencePool =
      []
        .concat(
          profile.hobbies
        )
        .concat(
          profile.likes
        );

    const positiveMatches =
      this.findPreferenceMatches(
        positivePreferencePool,
        source
      );

    if (
      positiveMatches.length > 0 &&
      attitude.attitude !==
        "negative"
    ) {
      let bonus =
        this.preferences
          .LIKE_BONUS;

      if (
        attitude.strongPositive ||
        attitude.defense
      ) {
        bonus =
          this.preferences
            .STRONG_LIKE_BONUS;
      }

      return {
        bonus:
          bonus,
        reason:
          "positive-preference",
        matched:
          positiveMatches[0]
      };
    }

    const dislikeMatches =
      this.findPreferenceMatches(
        profile.dislikes,
        source
      );

    if (
      dislikeMatches.length === 0
    ) {
      return {
        bonus: 0,
        reason: "",
        matched: ""
      };
    }

    if (
      attitude.attitude !==
      "positive"
    ) {
      return {
        bonus: 0,
        reason: "",
        matched: ""
      };
    }

    const matchedDislike =
      dislikeMatches[0];

    const previousConflicts =
      this.countPreviousPreferenceConflicts(
        matchedDislike,
        npc,
        source
      );

    if (
      previousConflicts >= 2
    ) {
      return {
        bonus:
          this.preferences
            .DISLIKE_REPEATED,
        reason:
          "repeated-dislike-conflict",
        matched:
          matchedDislike
      };
    }

    if (
      previousConflicts >= 1 ||
      attitude.defense
    ) {
      return {
        bonus:
          this.preferences
            .DISLIKE_INSISTENCE,
        reason:
          "dislike-insistence",
        matched:
          matchedDislike
      };
    }

    return {
      bonus:
        this.preferences
          .DISLIKE_CONFLICT,
      reason:
        "dislike-conflict",
      matched:
        matchedDislike
    };
  },

  updateNPC: function (
    npc,
    input,
    output
  ) {
    const relationships =
      this.init();

    const data =
      relationships.characters[
        npc.name
      ];

    if (!data) {
      return;
    }

    const signals =
      this.analyzeInteraction(
        input,
        output
      );

    let friendshipChange =
      this.getFriendshipDelta(
        signals
      );

    const preferenceEffect =
      this.getPreferenceEffect(
        npc,
        input
      );

    friendshipChange +=
      preferenceEffect.bonus;

    let romanceChange =
      0;

    const compatible =
      this.compatible(
        relationships.playerGender,
        npc.gender,
        npc.orientation
      );

    if (!compatible) {
      data.romance =
        0;

    } else {

      const receptivity =
        this.friendshipReceptivity(
          data.friendship
        );

      const statusMultiplier =
        this.romanceMultiplier(
          npc.romanticStatus
        );

      if (
        signals.romancePositive
      ) {
        romanceChange +=
          1.5 *
          statusMultiplier *
          receptivity;

      } else if (
        signals.romanceSoftPositive &&
        signals.playerFlirt
      ) {
        romanceChange +=
          0.60 *
          statusMultiplier *
          receptivity;
      }

      if (
        signals.romanceNegative
      ) {
        romanceChange -=
          2.5;
      }
    }

    if (
      signals.infidelity
    ) {
      friendshipChange -=
        2.0;

      if (
        compatible
      ) {
        romanceChange -=
          2.5;
      }
    }

    data.friendship =
      Math.max(
        -100,
        Math.min(
          100,
          Number(
            data.friendship || 0
          ) +
          friendshipChange
        )
      );

    if (
      compatible
    ) {
      data.romance =
        Math.max(
          0,
          Math.min(
            100,
            Number(
              data.romance || 0
            ) +
            romanceChange
          )
        );

    } else {
      data.romance =
        0;
    }
  },

  getHistoryActions: function () {
    if (
      !Array.isArray(
        history
      )
    ) {
      return [];
    }

    return history
      .slice(
        -this.tracker
          .MAX_HISTORY_ACTIONS
      )
      .map(
        action => {
          if (!action) {
            return "";
          }

          return String(
            action.text || ""
          );
        }
      )
      .filter(Boolean);
  },

  uniqueNamesInText: function (
    text,
    npcs
  ) {
    const source =
      String(
        text || ""
      );

    const found =
      [];

    for (
      const npc
      of npcs || []
    ) {
      if (
        !npc ||
        !npc.name
      ) {
        continue;
      }

      const fullName =
        String(
          npc.name
        ).trim();

      const firstName =
        fullName
          .split(
            /\s+/
          )[0];

      let matched =
        this.nameMatchesText(
          fullName,
          source
        );

      if (
        !matched &&
        firstName.length >=
          this.tracker.MIN_NAME_LENGTH
      ) {
        matched =
          this.nameMatchesText(
            firstName,
            source
          );
      }

      if (
        matched &&
        !found.includes(
          npc.name
        )
      ) {
        found.push(
          npc.name
        );
      }
    }

    return found;
  },

  resolveExplicitTarget: function (
    input,
    activeNames,
    npcs
  ) {
    const source =
      String(
        input || ""
      );

    const candidates =
      [];

    for (
      const activeName
      of activeNames || []
    ) {
      const npc =
        (npcs || []).find(
          x =>
            x.name ===
            activeName
        );

      if (!npc) {
        continue;
      }

      if (
        this.nameMatchesText(
          npc.name,
          source
        )
      ) {
        candidates.push(
          npc.name
        );
        continue;
      }

      const firstName =
        npc.name
          .split(/\s+/)[0];

      if (
        firstName.length >=
          this.tracker.MIN_NAME_LENGTH &&
        this.nameMatchesText(
          firstName,
          source
        )
      ) {
        candidates.push(
          npc.name
        );
      }
    }

    return candidates.length ===
      1
      ? candidates[0]
      : "";
  },

  updateSceneTracker: function (
    currentInput,
    npcs
  ) {
    const relationships =
      this.init();

    const tracker =
      relationships
        .sceneTracker;

    const input =
      String(
        currentInput || ""
      );

    const recentHistory =
      this.getHistoryActions();

    const historyText =
      recentHistory.join(
        "\n"
      );

    const currentInputNames =
      this.uniqueNamesInText(
        input,
        npcs
      );

    const recentHistoryNames =
      this.uniqueNamesInText(
        historyText,
        npcs
      );

    const currentCombinedNames =
      this.uniqueNamesInText(
        input +
        "\n" +
        historyText,
        npcs
      );

    const explicitCurrentTarget =
      this.resolveExplicitTarget(
        input,
        currentCombinedNames,
        npcs
      );

    let activeNames =
      [];

    if (
      currentInputNames.length > 0
    ) {
      activeNames =
        currentInputNames.slice();

      for (
        const name
        of recentHistoryNames
      ) {
        if (
          !activeNames.includes(
            name
          )
        ) {
          activeNames.push(
            name
          );
        }
      }

    } else if (
      recentHistoryNames.length >
      0
    ) {
      activeNames =
        recentHistoryNames.slice();

    } else if (
      tracker.activeNames.length >
        0 &&
      tracker.turnsSinceDetection <
        this.tracker
          .ACTIVE_PERSIST_TURNS
    ) {
      activeNames =
        tracker.activeNames.slice();
    }

    activeNames =
      activeNames.filter(
        (
          name,
          index,
          arr
        ) =>
          arr.indexOf(name) ===
          index
      );

    if (
      currentCombinedNames.length >
      0
    ) {
      tracker.lastDetectedNames =
        currentCombinedNames.slice();

      tracker.turnsSinceDetection =
        0;

    } else {
      tracker.turnsSinceDetection +=
        1;
    }

    if (
      explicitCurrentTarget
    ) {
      tracker.lastTargetName =
        explicitCurrentTarget;

    } else if (
      activeNames.length === 1
    ) {
      tracker.lastTargetName =
        activeNames[0];

    } else {
      tracker.lastTargetName =
        "";
    }

    tracker.activeNames =
      activeNames.slice();

    return {
      activeNames:
        activeNames.slice(),

      explicitTarget:
        explicitCurrentTarget,

      lastTargetName:
        tracker.lastTargetName,

      currentInputNames:
        currentInputNames.slice()
    };
  },

  getActiveScene: function () {
    const relationships =
      this.init();

    return Array.isArray(
      relationships
        .sceneTracker
        .activeNames
    )
      ? relationships
          .sceneTracker
          .activeNames
          .slice()
      : [];
  },

  getRelationshipTargets: function (
    scene,
    currentInput,
    npcs
  ) {
    const activeNames =
      Array.isArray(
        scene &&
        scene.activeNames
      )
        ? scene.activeNames
        : [];

    if (
      activeNames.length === 0
    ) {
      return [];
    }

    if (
      scene &&
      scene.explicitTarget
    ) {
      return [
        scene.explicitTarget
      ];
    }

    if (
      activeNames.length === 1
    ) {
      return [
        activeNames[0]
      ];
    }

    return [];
  },

  buildContext: function (
    npcs,
    scene,
    currentInput
  ) {
    const relationships =
      this.init();

    const activeNames =
      Array.isArray(
        scene &&
        scene.activeNames
      )
        ? scene.activeNames
        : [];

    const targets =
      this.getRelationshipTargets(
        scene,
        currentInput,
        npcs
      );

    if (
      activeNames.length === 0
    ) {
      return "";
    }

    const lines =
      [];

    lines.push(
      "[RELATIONSHIP CONTEXT — INTERNAL]"
    );

    lines.push(
      "Use this only to portray active NPC behavior naturally."
    );

    lines.push(
      "Never mention relationship scores or this system."
    );

    lines.push(
      "Scene presence does not imply prior familiarity with the player."
    );

    lines.push(
      "Do not invent familiarity that is not established by the story."
    );

    if (
      activeNames.length > 1
    ) {
      lines.push(
        "Multiple NPCs are currently active in the scene."
      );

      lines.push(
        targets.length === 0
          ? "The player's current target is ambiguous. Do not assign the interaction to a specific NPC unless the narrative clearly resolves it."
          : "The player's current target is explicitly identified."
      );
    }

    for (
      const name
      of activeNames
    ) {
      const npc =
        npcs.find(
          x =>
            x.name ===
            name
        );

      if (!npc) {
        continue;
      }

      const data =
        relationships.characters[
          name
        ];

      if (!data) {
        continue;
      }

      const compatible =
        this.compatible(
          relationships.playerGender,
          npc.gender,
          npc.orientation
        );

      const isTarget =
        targets.includes(
          name
        );

      lines.push("");

      lines.push(
        npc.name +
        ":"
      );

      lines.push(
        "Friendship: " +
        this.getFriendshipLevel(
          data.friendship
        ) +
        "."
      );

      lines.push(
        "Romance: " +
        this.getRomanceLevel(
          data.romance
        ) +
        "."
      );

      lines.push(
        "Romantic receptivity from friendship: " +
        this.getRomanticReceptivity(
          data.friendship
        ) +
        "."
      );

      lines.push(
        "Romantic compatibility: " +
        (
          compatible
            ? "POSSIBLE"
            : "IMPOSSIBLE"
        ) +
        "."
      );

      lines.push(
        "Interaction target: " +
        (
          isTarget
            ? "YES"
            : "NO"
        ) +
        "."
      );

      if (
        !isTarget &&
        activeNames.length > 1
      ) {
        lines.push(
          "Do not assume the player's ambiguous action is directed at this NPC."
        );
      }

      if (
        !compatible
      ) {
        lines.push(
          "ROMANCE LOCK: This NPC cannot develop romantic or sexual attraction toward the player. Do not portray flirting, affection, intimacy, or closeness as reciprocal romantic attraction."
        );
      }

      if (
        npc.romanticStatus ===
        "crush"
      ) {
        lines.push(
          "Existing crush on " +
          npc.romanticTarget +
          ". Romance with the player is slower and more complicated."
        );
      }

      if (
        npc.romanticStatus ===
        "in-love"
      ) {
        lines.push(
          "Already in love with " +
          npc.romanticTarget +
          ". Romance with the player is very difficult."
        );
      }

      if (
        npc.romanticStatus ===
        "relationship"
      ) {
        lines.push(
          "Already in a relationship with " +
          npc.romanticTarget +
          ". Any attraction to the player is conflicted and difficult."
        );
      }

      if (
        npc.romanticStatus ===
        "married"
      ) {
        lines.push(
          "Married to " +
          npc.romanticTarget +
          ". Any attraction to the player is highly difficult and consequential."
        );
      }

      lines.push(
        "Friendship and romance are independent."
      );

      lines.push(
        "Romance describes this NPC's feelings toward the player, not the player's feelings."
      );
    }

    lines.push("");

    lines.push(
      "[END RELATIONSHIP CONTEXT]"
    );

    return lines.join(
      "\n"
    );
  }
};


const RELStatus = {

  CONFIG_KEY:
    "__BASIC_REL_CONFIG__",

  CONFIG_TYPE:
    "BASIC_REL_CONFIG",

  STATUS_TYPE:
    "BASIC_REL_STATUS",

  WATERMARK:
    "Basic REL v3 • @Nynaleath",

  round: function (
    value
  ) {
    return Math.round(
      Number(
        value || 0
      ) *
      10
    ) / 10;
  },

  normalizeName: function (
    value
  ) {
    return String(
      value || ""
    )
      .trim()
      .replace(
        /\s+/g,
        " "
      );
  },

  cleanCharacterName: function (
    value
  ) {
    let name =
      this.normalizeName(
        value
      );

    name =
      name
        .replace(
          /^[-•*]\s*/,
          ""
        )
        .trim();

    return name;
  },

  getConfigCard: function (
    cards
  ) {
    for (
      const card
      of cards || []
    ) {

      const keys =
        String(
          card.keys || ""
        );

      const keyList =
        keys
          .split(",")
          .map(
            x =>
              x.trim()
          );

      const singularKey =
        String(
          card.key || ""
        ).trim();

      if (
        keyList.includes(
          this.CONFIG_KEY
        ) ||
        singularKey ===
          this.CONFIG_KEY ||
        String(
          card.type || ""
        ) ===
          this.CONFIG_TYPE
      ) {
        return card;
      }
    }

    return null;
  },

  ensureManualEditSection: function (
    config
  ) {
    if (!config) {
      return null;
    }

    let entry =
      String(
        config.entry || ""
      );

    if (
      !entry.trim()
    ) {
      return config;
    }

    entry =
      entry.replace(
        /BASIC REL v2/g,
        "BASIC REL v3"
      );

    entry =
      entry.replace(
        /Basic REL v2\s+•\s+@Nynaleath/g,
        this.WATERMARK
      );

    if (
      /^\s*Manual\s+Stat\s+Edit\s*:/im.test(
        entry
      )
    ) {
      if (
        config.entry !==
        entry
      ) {
        const index =
          storyCards.indexOf(
            config
          );

        if (
          index >= 0
        ) {
          updateStoryCard(
            index,
            String(
              config.keys ||
              this.CONFIG_KEY
            ),
            entry,
            String(
              config.type ||
              this.CONFIG_TYPE
            )
          );

          config.entry =
            entry;
        }
      }

      return config;
    }

    const manualSection =
      "\n\n" +
      "Manual Stat Edit:\n" +
      "Character:\n" +
      "Apply: no\n" +
      "Friendship: unchanged\n" +
      "Romance: unchanged\n";

    const watermarkPattern =
      /(?:Basic REL v\d+\s+•\s+@Nynaleath)/i;

    if (
      watermarkPattern.test(
        entry
      )
    ) {
      entry =
        entry.replace(
          watermarkPattern,
          manualSection +
          "\n" +
          this.WATERMARK
        );
    } else {
      entry +=
        manualSection +
        "\n" +
        this.WATERMARK;
    }

    const index =
      storyCards.indexOf(
        config
      );

    if (
      index >= 0
    ) {
      updateStoryCard(
        index,
        String(
          config.keys ||
          this.CONFIG_KEY
        ),
        entry,
        String(
          config.type ||
          this.CONFIG_TYPE
        )
      );

      config.entry =
        entry;
    }

    return config;
  },

  ensureConfigCard: function () {
    const existing =
      this.getConfigCard(
        storyCards
      );

    if (existing) {
      return this.ensureManualEditSection(
        existing
      );
    }

    const entry =
      "BASIC REL v3 — Relationship Status Configuration\n\n" +

      "Tracked Characters:\n\n" +

      "INSTRUCTIONS:\n" +
      "Enter the exact names of the NPCs you want to track.\n" +
      "Separate multiple names with commas.\n\n" +

      "Example:\n" +
      "Character A, Character B, Character C\n\n" +

      "Only characters listed in Tracked Characters will receive a visible Relationship Status card.\n\n" +

      "You can edit this card at any time during the adventure.\n" +
      "For best compatibility, place the names in the Story Card Notes field.\n" +
      "If Notes are unavailable to the script, use the Tracked Characters section in this Entry instead.\n\n" +

      "The Basic REL system continues tracking relationship data internally even when a character is not displayed.\n\n" +

      "Manual Stat Edit:\n" +
      "Character:\n" +
      "Apply: no\n" +
      "Friendship: unchanged\n" +
      "Romance: unchanged\n\n" +

      this.WATERMARK;

    addStoryCard(
      this.CONFIG_KEY,
      entry,
      this.CONFIG_TYPE
    );

    return this.getConfigCard(
      storyCards
    );
  },

  extractNamesFromText: function (
    text
  ) {
    const source =
      String(
        text || ""
      );

    if (
      !source.trim()
    ) {
      return [];
    }

    const names =
      [];

    const fragments =
      source.split(
        /[,;\n]+/
      );

    for (
      const fragment
      of fragments
    ) {
      const name =
        this.cleanCharacterName(
          fragment
        );

      if (!name) {
        continue;
      }

      if (
        !names.some(
          existing =>
            existing
              .toLowerCase() ===
            name.toLowerCase()
        )
      ) {
        names.push(
          name
        );
      }
    }

    return names;
  },

  getTrackedCharacters: function () {
    const config =
      this.ensureConfigCard();

    if (!config) {
      return [];
    }

    const notes =
      String(
        config.notes || ""
      ).trim();

    if (notes) {
      const noteNames =
        this.extractNamesFromText(
          notes
        );

      if (
        noteNames.length > 0
      ) {
        return noteNames;
      }
    }

    const entry =
      String(
        config.entry || ""
      );

    const trackedMatch =
      entry.match(
        /Tracked Characters\s*:\s*([\s\S]*?)(?=\n\s*(?:INSTRUCTIONS|Manual Stat Edit)\s*:)/i
      );

    if (
      trackedMatch &&
      trackedMatch[1]
    ) {
      return this.extractNamesFromText(
        trackedMatch[1]
      );
    }

    const lines =
      entry.split(
        /\r?\n/
      );

    let collecting =
      false;

    const collected =
      [];

    for (
      const line
      of lines
    ) {
      if (
        /^\s*Tracked Characters\s*:\s*$/i
          .test(line)
      ) {
        collecting =
          true;

        continue;
      }

      if (
        collecting &&
        (
          /^\s*INSTRUCTIONS\s*:\s*$/i
            .test(line) ||
          /^\s*Manual Stat Edit\s*:\s*$/i
            .test(line)
        )
      ) {
        break;
      }

      if (
        collecting &&
        line.trim()
      ) {
        collected.push(
          line.trim()
        );
      }
    }

    return this.extractNamesFromText(
      collected.join(
        "\n"
      )
    );
  },

  findTrackedNPC: function (
    trackedName,
    npcs
  ) {
    const target =
      this.normalizeName(
        trackedName
      ).toLowerCase();

    for (
      const npc
      of npcs || []
    ) {
      if (
        npc.name
          .toLowerCase() ===
        target
      ) {
        return npc;
      }
    }

    const firstMatches =
      (npcs || []).filter(
        npc =>
          npc.name
            .split(/\s+/)[0]
            .toLowerCase() ===
          target
      );

    if (
      firstMatches.length ===
      1
    ) {
      return firstMatches[0];
    }

    const partMatches =
      (npcs || []).filter(
        npc =>
          npc.name
            .split(/\s+/)
            .some(
              part =>
                part.toLowerCase() ===
                target
            )
      );

    if (
      partMatches.length ===
      1
    ) {
      return partMatches[0];
    }

    return null;
  },

  getStatusKey: function (
    characterName
  ) {
    const clean =
      this.normalizeName(
        characterName
      )
        .toUpperCase()
        .replace(
          /[^A-Z0-9]+/g,
          "_"
        )
        .replace(
          /^_+|_+$/g,
          ""
        );

    return (
      "__BASIC_REL_STATUS_" +
      clean +
      "__"
    );
  },

  getStatusCard: function (
    characterName
  ) {
    const key =
      this.getStatusKey(
        characterName
      );

    for (
      let index = 0;
      index < storyCards.length;
      index++
    ) {
      const card =
        storyCards[index];

      const keys =
        String(
          card.keys || ""
        );

      const keyList =
        keys
          .split(",")
          .map(
            x =>
              x.trim()
          );

      if (
        keyList.includes(
          key
        )
      ) {
        return {
          card:
            card,
          index:
            index
        };
      }

      if (
        String(
          card.type || ""
        ) ===
          this.STATUS_TYPE &&
        String(
          card.entry || ""
        ).startsWith(
          characterName +
          " — Relationship"
        )
      ) {
        return {
          card:
            card,
          index:
            index
        };
      }
    }

    return null;
  },

  buildEntry: function (
    characterName,
    character,
    npc
  ) {
    const friendship =
      this.round(
        character.friendship
      );

    const romance =
      this.round(
        character.romance
      );

    const activeNames =
      typeof REL !==
        "undefined" &&
      typeof REL.getActiveScene ===
        "function"
        ? REL.getActiveScene()
        : [];

    const isActive =
      activeNames.includes(
        characterName
      );

    const activeMarker =
      isActive
        ? "👥💕 ACTIVE\n\n"
        : "";

    return (
      characterName +
      " — Relationship\n\n" +

      activeMarker +

      "Friendship: " +
      friendship +
      " — " +
      REL.getFriendshipLevel(
        friendship
      ) +
      "\n" +

      "Romance: " +
      romance +
      " — " +
      REL.getRomanceLevel(
        romance
      ) +
      "\n\n" +

      "This Relationship Status card is automatically generated by Basic REL v3.\n" +
      "Friendship and romance are tracked independently.\n" +
      "Romance represents " +
      characterName +
      "'s feelings toward the player.\n\n" +

      "Tracked through the Basic REL v3 configuration card.\n\n" +

      this.WATERMARK
    );
  },

  update: function (
    characterName,
    npc
  ) {
    const relationships =
      REL.init();

    const character =
      relationships.characters[
        characterName
      ];

    if (!character) {
      return;
    }

    const key =
      this.getStatusKey(
        characterName
      );

    const entry =
      this.buildEntry(
        characterName,
        character,
        npc
      );

    const existing =
      this.getStatusCard(
        characterName
      );

    if (existing) {

      updateStoryCard(
        existing.index,
        key,
        entry,
        this.STATUS_TYPE
      );

    } else {

      addStoryCard(
        key,
        entry,
        this.STATUS_TYPE
      );
    }
  },

  updateTrackedStatuses: function (
    npcs
  ) {
    const trackedNames =
      this.getTrackedCharacters();

    if (
      trackedNames.length === 0
    ) {
      return;
    }

    for (
      const trackedName
      of trackedNames
    ) {
      const npc =
        this.findTrackedNPC(
          trackedName,
          npcs
        );

      if (!npc) {
        continue;
      }

      this.update(
        npc.name,
        npc
      );
    }
  }
};
