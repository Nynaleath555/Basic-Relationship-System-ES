/* ============================================================
   BASIC REL ES v3
   VERSION: 3.0
   ============================================================ */

const REL = {

  VERSION: "3.0",

  genders: {
    man: ["man", "male", "boy"],
    woman: ["woman", "female", "girl"],
    "non-binary": [
      "non-binary",
      "nonbinary",
      "non binary",
      "enby",
      "nb"
    ]
  },

  orientations: [
    "heterosexual",
    "bisexual",
    "pansexual",
    "homosexual",
    "queer"
  ],

  tracker: {
    MAX_HISTORY_ACTIONS: 5,
    ACTIVE_PERSIST_TURNS: 3,
    MIN_NAME_LENGTH: 3
  },

  preferences: {
    LIKE_BONUS: 0.35,
    STRONG_LIKE_BONUS: 0.50,

    DISLIKE_CONFLICT: -0.50,
    DISLIKE_INSISTENCE: -0.75,
    DISLIKE_REPEATED: -1.00
  },

  init: function () {
    if (!state.relationships) {
      state.relationships = {
        playerGender: "unknown",
        characters: {},
        lastInput: "",
        manualEditLastToken: "",
        sceneTracker: {
          activeNames: [],
          lastDetectedNames: [],
          lastTargetName: "",
          turnsSinceDetection: 999
        }
      };
    }

    if (!state.relationships.characters) {
      state.relationships.characters = {};
    }

    if (!state.relationships.playerGender) {
      state.relationships.playerGender = "unknown";
    }

    if (!state.relationships.lastInput) {
      state.relationships.lastInput = "";
    }

    if (
      typeof state.relationships.manualEditLastToken !==
      "string"
    ) {
      state.relationships.manualEditLastToken = "";
    }

    if (!state.relationships.sceneTracker) {
      state.relationships.sceneTracker = {
        activeNames: [],
        lastDetectedNames: [],
        lastTargetName: "",
        turnsSinceDetection: 999
      };
    }

    if (
      !Array.isArray(
        state.relationships.sceneTracker.activeNames
      )
    ) {
      state.relationships.sceneTracker.activeNames = [];
    }

    if (
      !Array.isArray(
        state.relationships.sceneTracker.lastDetectedNames
      )
    ) {
      state.relationships.sceneTracker.lastDetectedNames = [];
    }

    if (
      !Number.isFinite(
        state.relationships.sceneTracker.turnsSinceDetection
      )
    ) {
      state.relationships.sceneTracker.turnsSinceDetection = 999;
    }

    if (
      typeof state.relationships.sceneTracker.lastTargetName !==
      "string"
    ) {
      state.relationships.sceneTracker.lastTargetName = "";
    }

    return state.relationships;
  },

  normalizeGender: function (value) {
    const v =
      String(value || "")
        .toLowerCase()
        .trim();

    for (const gender in this.genders) {
      if (this.genders[gender].includes(v)) {
        return gender;
      }
    }

    return "unknown";
  },

  normalizeOrientation: function (value) {
    const v =
      String(value || "")
        .toLowerCase()
        .trim();

    if (this.orientations.includes(v)) {
      return v;
    }

    if (
      v === "straight" ||
      v === "hetero"
    ) {
      return "heterosexual";
    }

    if (
      v === "gay" ||
      v === "lesbian"
    ) {
      return "homosexual";
    }

    return "unknown";
  },

  parsePlayerGender: function (contextText) {
    const text =
      String(contextText || "");

    let essentials =
      text;

    const cutPoints = [
      text.search(/World Lore:/i),
      text.search(/Story Summary:/i),
      text.search(/Memories:/i)
    ].filter(
      n => n >= 0
    );

    if (
      cutPoints.length > 0
    ) {
      essentials =
        text.slice(
          0,
          Math.min.apply(
            null,
            cutPoints
          )
        );
    }

    let match =
      essentials.match(
        /\bGender:\s*([^\n\r]+)/i
      );

    if (match) {
      const gender =
        this.normalizeGender(
          match[1]
        );

      if (
        gender !== "unknown"
      ) {
        return gender;
      }
    }

    match =
      essentials.match(
        /\bPronouns:\s*([^\n\r]+)/i
      );

    if (match) {
      const pronouns =
        match[1]
          .toLowerCase();

      if (
        /\bshe\s*\/\s*her\b/.test(
          pronouns
        )
      ) {
        return "woman";
      }

      if (
        /\bhe\s*\/\s*him\b/.test(
          pronouns
        )
      ) {
        return "man";
      }

      if (
        /\bthey\s*\/\s*them\b/.test(
          pronouns
        )
      ) {
        return "non-binary";
      }
    }

    return "unknown";
  },

  parsePreferenceList: function (
    entry,
    label
  ) {
    const source =
      String(entry || "");

    const escapedLabel =
      String(label || "")
        .replace(
          /[.*+?^${}()|[\]\\]/g,
          "\\$&"
        );

    const match =
      source.match(
        new RegExp(
          "^\\s*" +
          escapedLabel +
          "\\s*:\\s*([^\\n\\r]+)",
          "im"
        )
      );

    if (!match) {
      return [];
    }

    return match[1]
      .split(",")
      .map(
        item =>
          String(item || "")
            .trim()
            .replace(
              /^[-•*]\s*/,
              ""
            )
            .trim()
      )
      .filter(Boolean);
  },

  extractFlexibleField: function (
    text,
    patterns
  ) {
    const source =
      String(text || "");

    for (
      const pattern
      of patterns || []
    ) {
      const match =
        source.match(pattern);

      if (
        match &&
        match[1] &&
        String(match[1]).trim()
      ) {
        return String(
          match[1]
        ).trim();
      }
    }

    return "";
  },

  extractFlexibleList: function (
    text,
    patterns
  ) {
    const value =
      this.extractFlexibleField(
        text,
        patterns
      );

    if (!value) {
      return [];
    }

    return value
      .split(
        /,(?![^(]*\))|\s+\band\b\s+|\s*;\s*/
      )
      .map(
        item =>
          String(item || "")
            .trim()
            .replace(
              /^[-•*]\s*/,
              ""
            )
            .trim()
      )
      .filter(Boolean);
  },

  parseFlexibleName: function (
    entry
  ) {
    const source =
      String(entry || "");

    const value =
      this.extractFlexibleField(
        source,
        [
          /^\s*(?:Complete\s+Name|Full\s+Name|Character\s+Name|NPC\s+Name)\s*:\s*([^\n\r]+)/im,
          /^\s*(?:Complete\s+Name|Full\s+Name|Character\s+Name|NPC\s+Name)\s*=\s*([^\n\r]+)/im,
          /^\s*Name\s*:\s*([^\n\r]+)/im,
          /^\s*Name\s*=\s*([^\n\r]+)/im,
          /\b(?:character_name|character-name|full_name)\s*[:=]\s*["']?([^"'\n\r]+)["']?/i
        ]
      );

    return String(
      value || ""
    )
      .trim()
      .replace(
        /^[-•*]\s*/,
        ""
      )
      .trim();
  },

  parseFlexibleAge: function (
    entry
  ) {
    const source =
      String(entry || "");

    let match =
      source.match(
        /\b(?:Age|Years?\s*Old)\s*:\s*(\d{1,3})\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\baged\s+(\d{1,3})\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s*[- ]year[- ]old\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s+years?\s+old\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    match =
      source.match(
        /\b(\d{1,3})\s+years?\b/i
      );

    if (match) {
      return Number(
        match[1]
      );
    }

    return null;
  },

  parseFlexibleGender: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Gender\s*:\s*([^\n\r]+)/im,
          /^\s*Sex\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const direct =
        this.normalizeGender(
          value
        );

      if (
        direct !== "unknown"
      ) {
        return direct;
      }

      const lowered =
        value.toLowerCase();

      if (
        /\bnon[- ]?binary\b/.test(
          lowered
        ) ||
        /\benby\b/.test(
          lowered
        )
      ) {
        return "non-binary";
      }

      if (
        /\bmale\b|\bman\b|\bboy\b/.test(
          lowered
        )
      ) {
        return "man";
      }

      if (
        /\bfemale\b|\bwoman\b|\bgirl\b/.test(
          lowered
        )
      ) {
        return "woman";
      }
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bshe\s*\/\s*her\b/i
        .test(source)
    ) {
      return "woman";
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bhe\s*\/\s*him\b/i
        .test(source)
    ) {
      return "man";
    }

    if (
      /\bpronouns?\s*:\s*[^\n\r]*\bthey\s*\/\s*them\b/i
        .test(source)
    ) {
      return "non-binary";
    }

    if (
      /\b(?:he|him)\s+(?:is|identifies as)\s+(?:a\s+)?(?:man|male|boy)\b/i
        .test(source)
    ) {
      return "man";
    }

    if (
      /\b(?:she|her)\s+(?:is|identifies as)\s+(?:a\s+)?(?:woman|female|girl)\b/i
        .test(source)
    ) {
      return "woman";
    }

    if (
      /\b(?:they|them)\s+(?:are|identify as)\s+(?:a\s+)?(?:non[- ]?binary|enby)\b/i
        .test(source)
    ) {
      return "non-binary";
    }

    if (
      /\bnon[- ]?binary\b/i.test(
        source
      )
    ) {
      return "non-binary";
    }

    if (
      /\bfemale\b/i.test(
        source
      )
    ) {
      return "woman";
    }

    if (
      /\bmale\b/i.test(
        source
      )
    ) {
      return "man";
    }

    return "unknown";
  },

  parseFlexibleOrientation: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Orientation\s*:\s*([^\n\r]+)/im,
          /^\s*Sexual\s+Orientation\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const direct =
        this.normalizeOrientation(
          value
        );

      if (
        direct !== "unknown"
      ) {
        return direct;
      }
    }

    const lowered =
      source.toLowerCase();

    if (
      /\bpansexual\b/.test(
        lowered
      )
    ) {
      return "pansexual";
    }

    if (
      /\bbisexual\b/.test(
        lowered
      )
    ) {
      return "bisexual";
    }

    if (
      /\bheterosexual\b/.test(
        lowered
      ) ||
      /\bstraight\b/.test(
        lowered
      )
    ) {
      return "heterosexual";
    }

    if (
      /\bhomosexual\b/.test(
        lowered
      ) ||
      /\bgay\b/.test(
        lowered
      ) ||
      /\blesbian\b/.test(
        lowered
      )
    ) {
      return "homosexual";
    }

    if (
      /\bqueer\b/.test(
        lowered
      )
    ) {
      return "queer";
    }

    return "unknown";
  },

  parseFlexibleRelationshipStatus: function (
    entry
  ) {
    const source =
      String(entry || "");

    let value =
      this.extractFlexibleField(
        source,
        [
          /^\s*Relationship\s+Status\s*:\s*([^\n\r]+)/im,
          /^\s*Romantic\s+Status\s*:\s*([^\n\r]+)/im,
          /^\s*Status\s*:\s*([^\n\r]+)/im
        ]
      );

    if (value) {
      const lowered =
        value.toLowerCase();

      if (
        /\bmarried\b/.test(
          lowered
        )
      ) {
        return {
          status: "married",
          target: ""
        };
      }

      if (
        /\bengaged\b/.test(
          lowered
        )
      ) {
        return {
          status: "relationship",
          target: ""
        };
      }

      if (
        /\bin\s+(?:a\s+)?relationship\b/.test(
          lowered
        ) ||
        /\bdating\b/.test(
          lowered
        )
      ) {
        return {
          status: "relationship",
          target: ""
        };
      }

      if (
        /\bin[- ]love\b/.test(
          lowered
        )
      ) {
        return {
          status: "in-love",
          target: ""
        };
      }

      if (
        /\bcrush\b/.test(
          lowered
        )
      ) {
        return {
          status: "crush",
          target: ""
        };
      }

      if (
        /\bsingle\b/.test(
          lowered
        )
      ) {
        return {
          status: "single",
          target: ""
        };
      }
    }

    let match =
      source.match(
        /has\s+a\s+crush\s+on\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "crush",
        target:
          match[1].trim()
      };
    }

    match =
      source.match(
        /is\s+in\s+love\s+with\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "in-love",
        target:
          match[1].trim()
      };
    }

    match =
      source.match(
        /is\s+in\s+a\s+relationship\s+with\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "relationship",
        target:
          match[1].trim()
      };
    }

    match =
      source.match(
        /married\s+to\s+([^.\n]+)/i
      );

    if (match) {
      return {
        status: "married",
        target:
          match[1].trim()
      };
    }

    return {
      status: "single",
      target: ""
    };
  },

  parseFlexiblePreferenceProfile: function (
    entry
  ) {
    const source =
      String(entry || "");

    const result = {
      hobbies: [],
      likes: [],
      dislikes: []
    };

    result.hobbies =
      this.extractFlexibleList(
        source,
        [
          /^\s*Hobbies?\s*:\s*([^\n\r]+)/im,
          /^\s*Pastimes?\s*:\s*([^\n\r]+)/im,
          /^\s*Hobbies?\s*=\s*([^\n\r]+)/im,
          /\bhobbies?\s+include\s+([^\n\r.]+)/i
        ]
      );

    result.likes =
      this.extractFlexibleList(
        source,
        [
          /^\s*Likes?\s*:\s*([^\n\r]+)/im,
          /^\s*Favorites?\s*:\s*([^\n\r]+)/im,
          /^\s*Favourites?\s*:\s*([^\n\r]+)/im,
          /^\s*Interests?\s*:\s*([^\n\r]+)/im,
          /^\s*Enjoys?\s*:\s*([^\n\r]+)/im,
          /^\s*Likes?\s*=\s*([^\n\r]+)/im
        ]
      );

    result.dislikes =
      this.extractFlexibleList(
        source,
        [
          /^\s*Dislikes?\s*:\s*([^\n\r]+)/im,
          /^\s*Hates?\s*:\s*([^\n\r]+)/im,
          /^\s*Dislikes?\s*=\s*([^\n\r]+)/im,
          /\b(?:dislikes|hates|cannot stand|can't stand|does not like|doesn't like)\s+([^\n\r.]+)/i
        ]
      );

    if (
      result.hobbies.length === 0
    ) {
      const naturalHobbies =
        source.match(
          /\benhoy?s?\s+(?:spending\s+time\s+)?(?:on|with)?\s*([^.\n]+)/i
        );

      if (
        naturalHobbies
      ) {
        const value =
          naturalHobbies[1]
            .trim();

        if (
          value &&
          !/\b(company|people|friends|family)\b/i.test(
            value
          )
        ) {
          result.hobbies =
            value
              .split(
                /,(?![^(]*\))|\s+\band\b\s+/
              )
              .map(
                item =>
                  item.trim()
              )
              .filter(Boolean);
        }
      }
    }

    if (
      result.likes.length === 0
    ) {
      const naturalLike =
        source.match(
          /\b(?:likes?|loves?|enjoys?)\s+([^.\n]+)/i
        );

      if (
        naturalLike
      ) {
        result.likes =
          naturalLike[1]
            .split(
              /,(?![^(]*\))|\s+\band\b\s+/
            )
            .map(
              item =>
                item.trim()
            )
            .filter(Boolean);
      }
    }

    return result;
  },

  getPreferenceProfile: function (
    entry
  ) {
    return {
      hobbies:
        this.parsePreferenceList(
          entry,
          "Hobbies"
        ),

      likes:
        this.parsePreferenceList(
          entry,
          "Likes"
        ),

      dislikes:
        this.parsePreferenceList(
          entry,
          "Dislikes"
        )
    };
  },

  normalizePreferenceTerm: function (
    term
  ) {
    let value =
      String(term || "")
        .toLowerCase()
        .trim();

    value =
      value.replace(
        /^[\s"'`]+|[\s"'`]+$/g,
        ""
      );

    value =
      value.replace(
        /^(?:to|the|a|an)\s+/i,
        ""
      );

    value =
      value.replace(
        /^playing\s+/i,
        ""
      );

    value =
      value.replace(
        /^spending\s+time\s+(?:on|with)\s+/i,
        ""
      );

    return value.trim();
  },

  getWordForms: function (
    word
  ) {
    const clean =
      String(word || "")
        .toLowerCase()
        .replace(
          /[^a-z0-9'-]/g,
          ""
        )
        .trim();

    if (!clean) {
      return [];
    }

    const forms = [
      clean
    ];

    if (
      clean.endsWith("ing") &&
      clean.length > 5
    ) {
      const baseWithoutIng =
        clean.slice(0, -3);

      forms.push(
        baseWithoutIng
      );

      if (
        baseWithoutIng.length >= 3 &&
        !baseWithoutIng.endsWith("e")
      ) {
        forms.push(
          baseWithoutIng + "e"
        );
      }
    }

    if (
      clean.endsWith("ed") &&
      clean.length > 4
    ) {
      forms.push(
        clean.slice(0, -2)
      );
    }

    if (
      clean.endsWith("s") &&
      clean.length > 3
    ) {
      forms.push(
        clean.slice(0, -1)
      );
    }

    return forms.filter(
      (value, index, array) =>
        array.indexOf(value) ===
        index
    );
  },

  tokenisePreferenceTerm: function (
    term
  ) {
    const normalized =
      this.normalizePreferenceTerm(
        term
      );

    if (!normalized) {
      return [];
    }

    const ignored = [
      "the",
      "a",
      "an",
      "to",
      "of",
      "for",
      "with",
      "and",
      "or",
      "on",
      "in",
      "at",
      "about",
      "playing",
      "play",
      "plays",
      "doing",
      "do",
      "does"
    ];

    return normalized
      .split(/\s+/)
      .map(
        token =>
          token
            .replace(
              /^[^a-z0-9]+|[^a-z0-9]+$/gi,
              ""
            )
            .toLowerCase()
      )
      .filter(
        token =>
          token &&
          !ignored.includes(
            token
          )
      );
  },

  wordLike: function (
    a,
    b
  ) {
    const formsA =
      this.getWordForms(a);

    const formsB =
      this.getWordForms(b);

    for (
      const formA
      of formsA
    ) {
      for (
        const formB
        of formsB
      ) {
        if (
          formA === formB
        ) {
          return true;
        }
      }
    }

    return false;
  },

  preferenceMatchesInput: function (
    preference,
    input
  ) {
    const source =
      String(input || "")
        .toLowerCase();

    const normalized =
      this.normalizePreferenceTerm(
        preference
      );

    if (
      !normalized ||
      !source
    ) {
      return false;
    }

    const escaped =
      normalized.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
      );

    try {
      if (
        new RegExp(
          "\\b" +
          escaped +
          "\\b",
          "i"
        ).test(source)
      ) {
        return true;
      }
    } catch (error) {
      // Continue with token matching.
    }

    const tokens =
      this.tokenisePreferenceTerm(
        preference
      );

    if (
      tokens.length === 0
    ) {
      return false;
    }

    const inputTokens =
      source
        .split(/\s+/)
        .map(
          token =>
            token.replace(
              /^[^a-z0-9]+|[^a-z0-9]+$/gi,
              ""
            )
        )
        .filter(Boolean);

    if (
      tokens.length === 1
    ) {
      return inputTokens.some(
        inputToken =>
          this.wordLike(
            tokens[0],
            inputToken
          )
      );
    }

    for (
      const token
      of tokens
    ) {
      const found =
        inputTokens.some(
          inputToken =>
            this.wordLike(
              token,
              inputToken
            )
        );

      if (!found) {
        return false;
      }
    }

    return true;
  },

  findPreferenceMatches: function (
    preferences,
    input
  ) {
    const found = [];

    for (
      const preference
      of preferences || []
    ) {
      if (
        this.preferenceMatchesInput(
          preference,
          input
        )
      ) {
        found.push(
          preference
        );
      }
    }

    return found;
  },

  hasAny: function (
    text,
    patterns
  ) {
    const t =
      String(text || "")
        .toLowerCase();

    for (
      const pattern
      of patterns
    ) {
      if (
        pattern.test(t)
      ) {
        return true;
      }
    }

    return false;
  },

